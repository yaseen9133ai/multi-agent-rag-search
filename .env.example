# --- Cohere Configuration ---
# Get your API key at https://dashboard.cohere.com/
COHERE_API_KEY=your_cohere_api_key_here

# --- Qdrant Configuration ---
# For Qdrant Cloud: https://cloud.qdrant.io/
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=documents

# --- Retrieval Mode ---
# "visual" (default) — page-image multimodal embeddings + pre-baked Mistral OCR text. Reads the
#   ready-made <INGEST_DOC_BASENAME>.jsonl + .safetensors pair in ingestion/files/; no live
#   OCR/embedding calls at ingest time.
# "hybrid" — chunk the PDF's extracted text, embed dense (Cohere) + sparse (BM25),
#   fuse with RRF at query time. Runs live off ingestion/files/<INGEST_PDF_FILENAME> — no
#   pre-baked files needed, so this is the easier path for ingesting a PDF you don't have
#   pre-generated OCR/embedding assets for.
# The two modes store data in separate Qdrant collections (name-suffixed by mode), so switching
# is safe — just change this value and re-run ingestion (`make ingest`).
RETRIEVAL_MODE=visual

# hybrid mode only — the PDF (under ingestion/files/) to extract and chunk text from. Drop your
# own PDF into ingestion/files/ and point this at its filename; no OCR/embedding pre-processing
# needed for hybrid mode, unlike visual mode.
# Ships with a sample bilingual (Arabic/English) finance report so the stack runs out of the box —
# swap in your own PDF any time.
INGEST_PDF_FILENAME=article.pdf

# visual mode only — basename of the pre-baked ingestion/files/<name>.jsonl + <name>.safetensors
# pair. Defaults to INGEST_PDF_FILENAME's basename when unset; set explicitly when the baked
# files don't share the PDF's name (as with the bundled sample below).
INGEST_DOC_BASENAME=my_document

# --- Google Search Configuration ---
EXAAI_API_KEY=XXXXXX

# --- Google Cloud Configuration ---
PROJECT_ID=your-project-id
REGION=us-central1

# --- Cloud SQL Configuration ---
# Used for agent session persistence
INSTANCE_NAME=agent-sessions
DB_USER=app
DB_PASS=your_strong_db_password
# This will be constructed as PROJECT_ID:REGION:INSTANCE_NAME
CLOUDSQL_INSTANCE=your-project-id:us-central1:agent-sessions

# --- Local Development (Optional) ---
# If provided, the agent will use this URL instead of the Cloud SQL proxy logic
# SESSIONS_DB_URL=postgresql+asyncpg://app:password@localhost:5432/sessions

# ─────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────
# Local tracing is ON BY DEFAULT. docker-compose starts a Phoenix UI and points the
# agent at it (http://phoenix:6006/v1/traces) — open it at http://localhost:6006.
# These two vars are intentionally left UNSET so the compose defaults apply; don't
# uncomment them unless you want to change the behaviour.
#
# To run the stack WITHOUT tracing, uncomment:
# OBSERVABILITY_ENABLED=false
# Names local traces in Phoenix (the OTLP exporter reads it). Prod uses Langfuse instead.
OTEL_SERVICE_NAME=multi-agent-rag-search-local

# Privacy: redact prompt/response payloads while keeping trace structure (works for both backends).
# OPENINFERENCE_HIDE_INPUTS=true
# OPENINFERENCE_HIDE_OUTPUTS=true

# ── Production tracing (Cloud Run → Langfuse) ──────────────────────────────────
# Local dev uses Phoenix (above) and does NOT need these. They're only for the CLOUD deploy, where
# tracing to Langfuse is required. Put your keys here; the GCP guide's Step 3b reads them straight from
# this file to create the LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY secrets (the agent's Langfuse SDK
# reads those directly — no header to build).
# Keys: https://cloud.langfuse.com → your `multi-agent-rag-search-observability` project → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# US region? The deploy's OTLP endpoint lives in service.yaml (edit it there, per Step 3b).

# ─────────────────────────────────────────────────────────────────────────────
# EVALUATION
# ─────────────────────────────────────────────────────────────────────────────
# LLM-as-judge config (hallucinations_v1, final_response_match_v2, ...). The judge is independent of
# the agent model (which is Cohere).
#
# RECOMMENDED — run the judge on Vertex AI (bills to your GCP project / free-trial credits; avoids the
# AI-Studio free tier's ~20 req/DAY-per-model cap). Auth once: `gcloud auth application-default login`
# and `gcloud services enable aiplatform.googleapis.com`.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# FALLBACK — AI-Studio free key (set GOOGLE_GENAI_USE_VERTEXAI=FALSE to use it). https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
# The agent talks to the MCP Search server over Streamable HTTP. For local eval, point this at a
# running MCP server (e.g. `docker compose up -d mcp qdrant`). Defaults to the sidecar address.
MCP_SERVER_URL=http://localhost:3000/mcp
